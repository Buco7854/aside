{{!< default}}

{{#post}}
{{!-- Pages take tags too, so a page can carry the internal #sensitive tag --}}
{{> "sensitive-note"}}

<article class="article {{post_class}}{{#has tag="#sensitive"}}{{^match @custom.sensitive_content "Off"}} article--sensitive{{#match @custom.sensitive_content "Whole post"}} article--sensitive-all{{/match}}{{/match}}{{/has}}">

    {{#match @page.show_title_and_feature_image}}
        <header class="article__header">
            <h1 class="article__title">{{title}}<span class="article__mark" aria-hidden="true">&mdash;</span></h1>
        </header>

        {{#if feature_image}}
            <figure class="article__feature-image">
                <img
                    srcset="{{img_url feature_image size="m"}} 750w,
                            {{img_url feature_image size="l"}} 1200w,
                            {{img_url feature_image size="xl"}} 2000w"
                    sizes="(min-width: 60rem) 60rem, 100vw"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="eager"
                />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}
    {{/match}}

    <section class="content gh-content">
        {{content}}
    </section>

</article>
{{/post}}
