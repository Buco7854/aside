<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    {{!-- Basic meta; the advanced meta comes from {{ghost_head}} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {{!-- Fonts are self-hosted, so preload the two faces used above the fold --}}
    {{#if @custom.age_gate}}<meta name="rating" content="adult" />{{/if}}

    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/fraunces-latin.woff2"}}" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/inter-latin.woff2"}}" crossorigin />
    <link rel="preload" as="style" href="{{asset "built/screen.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />

    {{!-- Apply a saved theme choice before first paint. With no choice stored,
    color-scheme: light dark follows the operating system. --}}
    <script>
        (function () {
            try {
                var theme = localStorage.getItem("aside-theme");
                if (theme === "light" || theme === "dark") {
                    document.documentElement.classList.add(theme);
                }
                // Two separate answers: confirming your age is not the same as
                // asking to see graphic images. Applied here so neither the
                // gate nor the veil flashes for someone who has answered.
                if (localStorage.getItem("aside-age-ok") === "1") {
                    document.documentElement.classList.add("has-age-consent");
                }
                if (localStorage.getItem("aside-sensitive-ok") === "1") {
                    document.documentElement.classList.add("has-sensitive-consent");
                }
            } catch (e) {
                /* Storage can be unavailable; fall back to the OS preference. */
            }
        })();
    </script>

    {{!-- Fetch a page once a visitor looks likely to open it, so the click lands
    on something already in cache. Prefetch rather than prerender: prerendering
    runs the next page's scripts, which would skew analytics and member state. --}}
    <script type="speculationrules">
        {
            "prefetch": [
                {
                    "where": {
                        "and": [
                            { "href_matches": "/*" },
                            { "not": { "href_matches": "/ghost/*" } },
                            { "not": { "selector_matches": "[rel~=nofollow]" } }
                        ]
                    },
                    "eagerness": "moderate"
                }
            ]
        }
    </script>

    {{!-- Outputs SEO meta, structured data and code injection; keep it last --}}
    {{ghost_head}}

</head>

<body class="{{body_class}}{{#match @custom.title_font "Modern sans-serif"}} has-sans-title{{/match}}">

    <a class="skip-link" href="#main">{{t "Skip to content"}}</a>

    {{> "site-header"}}

    <main id="main" class="site-main">
        {{{body}}}
    </main>

    {{> "site-footer"}}

    {{> "age-gate"}}

    <script src="{{asset "built/theme.js"}}" defer></script>

    {{ghost_foot}}

</body>
</html>
