{{!< default}}

{{#author}}
<div class="container container--prose">

    <header class="archive-header">
        <p class="eyebrow">{{t "Author"}}</p>
        <h1 class="archive-header__title">{{name}}</h1>
        {{#if bio}}
            <p class="lede">{{bio}}</p>
        {{else}}
            <p class="lede">{{plural ../pagination.total empty="No posts" singular="% post" plural="% posts"}}</p>
        {{/if}}

        <ul class="archive-header__links">
            {{#if website}}
                <li><a href="{{website}}" rel="me noopener">{{t "Website"}}</a></li>
            {{/if}}
            {{#if twitter}}
                <li><a href="{{social_url type="twitter"}}" rel="me noopener">X</a></li>
            {{/if}}
            {{#if bluesky}}
                <li><a href="{{social_url type="bluesky"}}" rel="me noopener">Bluesky</a></li>
            {{/if}}
            {{#if mastodon}}
                <li><a href="{{social_url type="mastodon"}}" rel="me noopener">Mastodon</a></li>
            {{/if}}
            {{#if linkedin}}
                <li><a href="{{social_url type="linkedin"}}" rel="me noopener">LinkedIn</a></li>
            {{/if}}
        </ul>
    </header>

</div>
{{/author}}

<div class="container container--prose">
    {{#foreach posts}}
        {{> "post-row"}}
    {{/foreach}}

    {{> "pagination"}}
</div>
