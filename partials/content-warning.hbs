{{!--
    An editorial content note rather than an alert box: a rule, a small label,
    a line of explanation, and one quiet action. What it veils depends on the
    "Sensitive content" setting — pictures only, or the writing as well.

    Used by both post.hbs and page.hbs: pages take tags too, so a page can be
    tagged #sensitive in exactly the same way.
--}}
<aside class="content-note" data-content-warning>
    <hr class="rule" />
    <p class="eyebrow">{{t "Content note"}}</p>
    <p class="content-note__text">
        {{#if @custom.sensitive_text}}
            {{@custom.sensitive_text}}
        {{else}}
            {{#match @custom.sensitive_content "Whole post"}}
                {{t "This piece covers difficult material."}}
            {{else}}
                {{t "This piece covers difficult material. Its pictures stay hidden until you ask for them."}}
            {{/match}}
        {{/if}}
    </p>
    <button class="content-note__action" type="button" data-warning-accept="sensitive">
        {{#match @custom.sensitive_content "Whole post"}}
            {{t "Show the post"}}
        {{else}}
            {{t "Show the images"}}
        {{/match}}
        {{> "icons/arrow"}}
    </button>
</aside>
