{{!--
    Optional site-wide gate, shown once per device on the first visit.
    It is a courtesy notice, not access control — see the README.
--}}
{{#if @custom.age_gate}}
    <div class="age-gate" data-age-gate role="dialog" aria-modal="true" aria-labelledby="age-gate-title">
        <div class="age-gate__panel" tabindex="-1" data-age-gate-panel>
            <p class="eyebrow" id="age-gate-title">{{t "Before you start"}}</p>
            <p class="age-gate__text">
                {{#if @custom.age_gate_text}}
                    {{@custom.age_gate_text}}
                {{else}}
                    {{t "Some of the work published here is meant for an adult audience."}}
                {{/if}}
            </p>
            <div class="age-gate__actions">
                <button class="button" type="button" data-warning-accept="age">{{t "I am 18 or older"}}</button>
                <button class="button button--ghost" type="button" data-warning-decline>{{t "Not now"}}</button>
            </div>
            <p class="age-gate__note">{{t "We keep your answer on this device, so this only appears once."}}</p>
        </div>
    </div>
{{/if}}
