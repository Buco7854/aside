{{!< default}}

{{#post}}
<article class="article {{post_class}}">

    <header class="article__header">
        {{> "post-meta" show_author=true}}

        <h1 class="article__title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="lede article__excerpt">{{custom_excerpt}}</p>
        {{/if}}

        {{#if primary_tag}}
            <ul class="tag-list">
                {{#foreach tags limit="3"}}
                    <li><a href="{{url}}">{{name}}</a></li>
                {{/foreach}}
            </ul>
        {{/if}}
    </header>

    {{#if feature_image}}
        <figure class="article__feature-image">
            <img
                srcset="{{img_url feature_image size="s"}} 400w,
                        {{img_url feature_image size="m"}} 750w,
                        {{img_url feature_image size="l"}} 1200w,
                        {{img_url feature_image size="xl"}} 2000w"
                sizes="(min-width: 60rem) 60rem, 100vw"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="eager"
            />
            {{#if feature_image_caption}}
                <figcaption>{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <section class="content gh-content">
        {{content}}
    </section>

    <footer class="article__footer">
        {{#if tags}}
            <ul class="tag-list">
                {{#foreach tags}}
                    <li><a href="{{url}}">{{name}}</a></li>
                {{/foreach}}
            </ul>
        {{/if}}
        {{#if updated_at}}
            <p class="article__updated">{{t "Updated"}} {{date updated_at format="D MMMM YYYY"}}</p>
        {{/if}}
    </footer>

    <div class="article-prompt">
        {{> "subscribe-prompt"}}
    </div>

    {{!-- Two more posts, excluding this one. The {{#get}} filter only takes
    simple paths, so keep it to id:-{{id}}. Renders nothing on a one-post site. --}}
    {{#get "posts" filter="id:-{{id}}" limit="2" include="authors,tags" as |related|}}
        {{#if related}}
            <aside class="read-next">
                <hr class="rule" />
                <h2 class="read-next__title">{{t "Read next"}}</h2>
                <div class="post-feed post-feed--pair">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </aside>
        {{/if}}
    {{/get}}

    {{#if comments}}
        <section class="article-comments">
            {{comments color_scheme="auto"}}

            {{!-- Ghost renders the comments box in an iframe, which can only
            follow the operating system. If this visitor has picked a theme,
            hand that choice to the embed before its deferred script runs. --}}
            <script>
                (function () {
                    var root = document.documentElement;
                    var choice = root.classList.contains("dark")
                        ? "dark"
                        : root.classList.contains("light")
                          ? "light"
                          : null;
                    if (!choice) return;
                    var embed = document.querySelector("script[data-ghost-comments]");
                    if (embed) embed.setAttribute("data-color-scheme", choice);
                })();
            </script>
        </section>
    {{/if}}

</article>

{{/post}}
