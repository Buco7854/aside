{{!< default}}

{{!-- The tag above means: insert everything in this file into the {body} of
the default.hbs template. --}}

<div class="container">

    {{#is "home"}}
        {{^match @custom.homepage_header "Hidden"}}
            <section class="home-intro{{#match @custom.homepage_header "Compact"}} home-intro--compact{{/match}}">
                <p class="eyebrow">{{@site.title}}</p>
                {{#if @site.description}}
                    <h1 class="home-intro__title">
                        <span class="home-intro__mark" aria-hidden="true">&mdash;</span>{{@site.description}}
                    </h1>
                {{/if}}
                <div class="home-intro__actions">
                    {{#if @site.members_enabled}}
                        {{#unless @member}}
                            <a class="button" href="#/portal/signup">{{t "Subscribe"}} {{> "icons/arrow"}}</a>
                        {{/unless}}
                    {{/if}}
                    <a class="button button--ghost" href="{{@site.url}}/rss/">{{t "RSS feed"}}</a>
                </div>
            </section>

            <hr class="rule" />
        {{/match}}
    {{/is}}

    <section class="post-feed-section">
        {{#if posts}}
            <div class="post-feed">
                {{#if pagination.prev}}
                    {{!-- Later pages are a plain grid; the lead slot belongs to page one --}}
                    {{> "post-feed" lead_first=false}}
                {{else match @custom.lead_story "Featured post"}}
                    {{!-- Pin the newest post flagged "featured" in the editor, and
                    drop it from the feed below so it is not shown twice --}}
                    {{#get "posts" filter="featured:true" limit="1" include="authors,tags" as |pinned|}}
                        {{#if pinned}}
                            {{#foreach pinned}}
                                {{> "post-card" lead=true}}
                            {{/foreach}}
                            {{!-- Inside {{#get}} the context's `posts` is the
                            featured query, so hand the page's own feed in --}}
                            {{> "post-feed" posts=../posts lead_first=false skip_id=pinned.[0].id}}
                        {{else}}
                            {{> "post-feed" posts=../posts lead_first=true}}
                        {{/if}}
                    {{/get}}
                {{else match @custom.lead_story "Newest post"}}
                    {{> "post-feed" lead_first=true}}
                {{else}}
                    {{> "post-feed" lead_first=false}}
                {{/if}}
            </div>
        {{else}}
            <div class="notice">
                <p class="notice__mark" aria-hidden="true">&mdash;</p>
                <h1>{{t "Nothing published yet"}}</h1>
                <p class="lede">{{t "The first post will appear here as soon as it goes out."}}</p>
            </div>
        {{/if}}
    </section>

    {{> "pagination"}}

    {{#is "home"}}
        {{#if @custom.show_topics}}
            <section class="topics">
                <div class="section-header">
                    <h2>{{t "Topics"}}</h2>
                </div>
                {{> "tag-cloud" limit="12"}}
            </section>
        {{/if}}
    {{/is}}

</div>
